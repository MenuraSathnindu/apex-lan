{
  "name": "apex-lan",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w @apex/server\" \"npm run dev -w @apex/client\"",
    "build": "npm run build -w @apex/client && npm run build -w @apex/server",
    "start": "npm run start -w @apex/server",
    "host": "npm run build && npm start",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "handling": "node node_modules/tsx/dist/cli.mjs scripts/handling-report.ts",
    "assets": "node scripts/download-assets.mjs",
    "bots": "node node_modules/tsx/dist/cli.mjs scripts/bots.ts",
    "tracks": "node node_modules/tsx/dist/cli.mjs tools/build-tracks.ts",
    "tracks:check": "node node_modules/tsx/dist/cli.mjs tools/check-tracks.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "concurrently": "10.0.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "tsx": "4.23.15"
  },
  "engines": {
    "node": ">=22"
  }
}
